<div class="mb-3">
    <div class="nav nav-tabs">
        <a href="{{ path('/plugins/delainventory/front/dashboard.php') }}" class="nav-link">
            <i class="ti ti-dashboard me-1"></i>
            {{ __('Dashboard') }}
        </a>

        <a href="{{ path('/plugins/delainventory/front/settings.php') }}" class="nav-link active">
            <i class="ti ti-settings me-1"></i>
            {{ __('Setup') }}
        </a>
    </div>
</div>

<form method="post" action="{{ path('/plugins/delainventory/front/settings.form.php') }}" id="delainventory-settings-form">
  <div class="card shadow-sm">
    <div class="card-header">
      <h3 class="card-title">{{ __('Asset Types', 'delainventory') }}</h3>
    </div>

    <div class="card-body">
      <div class="row">
        {% for item in assets %}
          <div class="col-md-6 mb-3">
            <label class="w-100">
              <div class="card h-100">
                <div class="card-body d-flex justify-content-between">
                  <div>
                    <strong>{{ __(item.label, 'delainventory') }}</strong><br>

                    <small class="text-muted">
                      {{ __('Apply configuration for %s', 'delainventory')|format(__(item.label, 'delainventory')|lower) }}
                    </small>
                  </div>

                  <input type="checkbox" name="asset[{{ item.id }}]" value="1" {% if item.enabled %}checked{% endif %}>
                </div>
              </div>
            </label>
          </div>
        {% endfor %}
      </div>
    </div>
  </div>

  <div class="row justify-content-center mt-3">
    {# Connection #}
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-header">
          <h3 class="card-title">{{ __('Connection', 'delainventory') }}</h3>
        </div>

        <div class="card-body">
          <div class="mb-3">
            <label class="form-label" for="ip">{{ __('IP Address', 'delainventory') }}</label>
            <input type="text" class="form-control" id="ip" name="ip" value="{{ ip }}" placeholder="192.168.0.1">
          </div>

          <div class="mb-3">
            <label class="form-label" for="port">{{ __('Port', 'delainventory') }}</label>
            <input type="number" class="form-control" id="port" name="port" value="{{ port }}" min="1" max="65535" placeholder="9100">
          </div>

          <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-outline-primary" id="testPrinterConnection">
              <i class="ti ti-plug"></i>
              {{ __('Test connection', 'delainventory') }}
            </button>

            <span id="connectionResult"></span>
          </div>
        </div>
      </div>
    </div>

    {# ZPL Template #}
    <div class="col-md-6">
      <div class="card shadow-sm h-100">
        <div class="card-header">
          <h3 class="card-title">{{ __('ZPL Template', 'delainventory') }}</h3>
        </div>

        <div class="card-body">
          <div class="mb-3">
            <label class="form-label" for="zpl">{{ __('ZPL Code', 'delainventory') }}</label>
            <textarea class="form-control font-monospace" id="zpl" name="zpl" rows="12" placeholder="^XA&#10;...&#10;^XZ">{{ zpl }}</textarea>

            <div class="d-flex justify-content-between align-items-center mt-2">
              <small class="text-muted">
                {{ __('Use placeholders to insert asset information.', 'delainventory') }}
              </small>

              <div class="d-flex gap-2">
                <a href="https://labelary.com/viewer.html" target="_blank" class="btn btn-sm btn-outline-primary">
                  <i class="ti ti-eye"></i>
                  {{ __('Preview ZPL', 'delainventory') }}
                </a>

                <button type="button" class="btn btn-sm btn-outline-secondary" data-bs-toggle="modal" data-bs-target="#zplVariablesModal">
                  {{ __('View available tags', 'delainventory') }}
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <button type="submit" name="update" class="btn btn-primary mt-3">
    <i class="ti ti-device-floppy me-1"></i> {{ __('Save') }}
  </button>

  <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">

  {# ZPL Variables Modal #}
  <div class="modal fade" id="zplVariablesModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
      <div class="modal-content">
        <div class="modal-header">
          <h3 class="modal-title">
            {{ __('Available tags', 'delainventory') }}
          </h3>

          <button type="button" class="btn-close" data-bs-dismiss="modal"> </button>
        </div>

        <div class="modal-body">
          <p class="text-muted">
            {{ __('You can use any of these tags in the ZPL template. The tags are based on the Computer asset fields and follow the names defined in the database. Some fields may vary depending on the asset type used.', 'delainventory') }}
          </p>

          <table class="table table-hover table-sm">
            <thead>
              <tr>
                <th> {{ __('Tag', 'delainventory') }} </th>
              </tr>
            </thead>

            <tbody>
              {% for variable in variables %}
                <tr>
                  <td>
                    <code>{{ variable }}</code>
                  </td>
                </tr>
              {% endfor %}
            </tbody>
          </table>
        </div>

        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
            {{ __('Close') }}
          </button>
        </div>
      </div>
    </div>
  </div>
</form>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    const button = document.getElementById('testPrinterConnection');
    const result = document.getElementById('connectionResult');

    function showResult(message, success) {
      result.replaceChildren();

      const span = document.createElement('span');
      const icon = document.createElement('i');
      const text = document.createElement('span');

      span.className = success ? 'text-success' : 'text-danger';
      icon.className = success ? 'ti ti-circle-check' : 'ti ti-circle-x';
      text.textContent = message;

      span.append(icon, document.createTextNode(' '), text);
      result.appendChild(span);
    }

    button.addEventListener('click', async function () {
      const ip = document.getElementById('ip').value.trim();
      const port = document.getElementById('port').value;

      if (!ip || !port) {
        showResult("{{ __('Enter the IP address and port.', 'delainventory')|e('js') }}", false);
        return;
      }

      button.disabled = true;
      button.replaceChildren();

      const spinner = document.createElement('span');
      spinner.className = 'spinner-border spinner-border-sm me-1';
      button.append(spinner, document.createTextNode("{{ __('Testing...', 'delainventory')|e('js') }}"));
      result.replaceChildren();

      try {
        const formData = new FormData();
        const form = document.getElementById('delainventory-settings-form');

        formData.append('test_connection', '1');
        formData.append('ip', ip);
        formData.append('port', port);

        const csrfToken = document.querySelector('meta[property="glpi:csrf_token"]') ?.getAttribute('content');

        const response = await fetch(form.action, {
          method: 'POST',
          headers: {
            'X-Glpi-Csrf-Token': csrfToken,
            'X-Requested-With': 'XMLHttpRequest'
          },
          body: formData
        });

        const data = await response.json();

        if (data.success) {
          showResult(data.message, true);
        } else {
          showResult(data.message, false);
        }

      } catch (error) {
          showResult("{{ __('Error testing connection.', 'delainventory')|e('js') }}", false);
          console.error(error);
      } finally {
        button.disabled = false;
        button.replaceChildren();

        const icon = document.createElement('i');
        icon.className = 'ti ti-plug';
        button.append(icon, document.createTextNode(" {{ __('Test connection', 'delainventory')|e('js') }}"));
      }
    });
  });
</script>