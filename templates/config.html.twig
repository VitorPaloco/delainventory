<form method="post">
<div class="card shadow-sm">
  <div class="card-header">
    <h3 class="card-title">Tipos de Ativo</h3>
  </div>
  <div class="card-body">
    <div class="row">
      {% for item in assets %}
      <div class="col-md-6 mb-3">
        <label class="w-100">
          <div class="card h-100">
            <div class="card-body d-flex justify-content-between">
              <div>
                <strong>{{ item.label }}</strong><br>
                <small class="text-muted">
                  Aplicar configuração para {{ item.label|lower }}
                </small>
              </div>
              <input type="checkbox"
                     name="asset[{{ item.id }}]"
                     value="1"
                     {% if item.enabled %}checked{% endif %}>
            </div>
          </div>
        </label>
      </div>
      {% endfor %}
    </div>
  </div>
</div>
<div class="row justify-content-center mt-3">
  <div class="col-md-6">
    <div class="card shadow-sm h-100">
      <div class="card-header">
        <h3 class="card-title">Conexão</h3>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <label class="form-label" for="ip">Endereço IP</label>
          <input type="text" class="form-control" id="ip" name="ip"
                 value="{{ ip }}" placeholder="192.168.0.1">
        </div>
        <div class="mb-3">
          <label class="form-label" for="port">Porta</label>
          <input type="number" class="form-control" id="port" name="port"
                 value="{{ port }}" min="1" max="65535" placeholder="8080">
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-6">
    <div class="card shadow-sm h-100">
      <div class="card-header">
        <h3 class="card-title">Modelo ZPL</h3>
      </div>
      <div class="card-body">
        <div class="mb-3">
          <label class="form-label" for="zpl">Código ZPL</label>
          <textarea class="form-control font-monospace" id="zpl" name="zpl" rows="12" placeholder="^XA&#10;...&#10;^XZ">{{ zpl }}</textarea>
          <div class="d-flex justify-content-between align-items-center mt-2">
            <small class="text-muted"> Utilize marcadores para inserir informações do ativo. </small>

            <button type="button" class="btn btn-sm btn-outline-secondary"
                data-bs-toggle="modal"
                data-bs-target="#zplVariablesModal">
                Visualizar tags disponíveis
            </button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
<button type="submit" name="update" class="btn btn-primary mt-3">
Salvar
</button>
<input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">

<div class="modal fade" id="zplVariablesModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-scrollable">
        <div class="modal-content">

            <div class="modal-header">
                <h3 class="modal-title">
                    Tags disponíveis
                </h3>

                <button
                    type="button"
                    class="btn-close"
                    data-bs-dismiss="modal">
                </button>
            </div>

            <div class="modal-body">

                <p class="text-muted">
                  Você pode utilizar qualquer uma destas tags no modelo ZPL. As tags são baseadas nos campos do 
                  ativo <b>Computer</b> e seguem os nomes definidos no banco de dados. Alguns campos podem variar conforme o tipo de ativo utilizado.
                </p>

                <table class="table table-hover table-sm">
                    <thead>
                        <tr>
                            <th>Tag</th>
                        </tr>
                    </thead>

                    <tbody>

                    {% for variable in variables %}
                        <tr>
                            <td>
                                <code>{{ variable }}</code>
                            </td>
                        </tr>
                    {% endfor %}

                    </tbody>
                </table>

            </div>

            <div class="modal-footer">

                <button
                    type="button"
                    class="btn btn-secondary"
                    data-bs-dismiss="modal">
                    Fechar
                </button>

            </div>

        </div>
    </div>
</div>
</form>